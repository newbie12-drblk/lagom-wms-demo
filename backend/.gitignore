# Tạo file .gitignore với nội dung đầy đủ
cat > .gitignore << 'EOF'
# Environment variables
backend/.env
.env
.env.local
.env.production
.env.*.local

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads
backend/uploads/
uploads/
*.tmp

# Database
*.sqlite
*.db
*.sql
*.sql.gz

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Backup
*.bak
*.backup
backup/

# Build
dist/
build/
*.min.js
*.min.css

# Misc
*.zip
*.tar.gz
EOF